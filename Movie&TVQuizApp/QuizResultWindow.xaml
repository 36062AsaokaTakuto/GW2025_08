<Window x:Class="Movie_AnimeQuizApp.Views.QuizResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Result"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0E0F12"
        Foreground="#EDEDED">

    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#8017181D"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20222A"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#802A2D38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#803A3E4D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9ABB6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 背景画像 -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="1.0"/>

        <!-- 暗幕 -->
        <Border Background="#B30E0F12"/>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 右上：正答率 -->
            <Border Grid.Row="0" Background="Transparent"
                    Style="{StaticResource CardBorderStyle}"
                    HorizontalAlignment="Right"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="正答率"
                               Style="{StaticResource SubtleTextStyle}"
                               HorizontalAlignment="Center" FontSize="40"/>
                    <TextBlock x:Name="ProgressText"
                               Text="0 / 0"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="#EDEDED"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 中央：上=〇/×（最大化） 下=カード（問題文は全部表示） -->
            <Grid Grid.Row="1"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <!-- 〇/×：残り全部 -->
                    <RowDefinition Height="*"/>
                    <!-- カード：必要分だけ -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 〇/×：Viewboxで“見切れない範囲で最大” -->
                <!-- ★Paddingを減らして〇をもっと大きく -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        Padding="0,0,0,0">
                    <!-- ★DownOnlyだと×が拡大できず小さく見える → Bothにする -->
                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <TextBlock x:Name="ResultText"
                                   Text="〇"
                                   FontSize="900"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>
                </Border>

                <!-- カード（正解文＋問題文） -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="28"
                        HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0">

                        <!-- 正解は〇〇です。 -->
                        <TextBlock x:Name="CorrectAnswerText"
                                   Text="正解は〇〇です。"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,18"/>

                        <!-- 問題文：改行基準を広げる（2.5倍相当） -->
                        <TextBlock x:Name="QuestionText"
                                   FontSize="26"
                                   Foreground="#EDEDED"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="1800"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 下：ボタン -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="NextBtn"
                        Grid.Column="0"
                        Content="次の問題へ"
                        Height="64"
                        Style="{StaticResource FlatButtonStyle}"
                        Click="NextBtn_Click"/>

                <Button x:Name="CloseBtn"
                        Grid.Column="2"
                        Content="閉じる"
                        Height="64"
                        Style="{StaticResource FlatButtonStyle}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
