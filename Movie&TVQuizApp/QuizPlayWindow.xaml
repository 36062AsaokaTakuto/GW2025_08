<Window x:Class="Movie_AnimeQuizApp.Views.QuizPlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz" Height="600" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="#0E0F12" Foreground="#EDEDED"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#17181D"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#2A2C34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Choice用（既存そのまま：ホバー/押下が半透明） -->
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20222A"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#802A2D38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#803A3E4D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ★追加：閉じるボタン専用（QuizDeleteWindow と同じ色/ホバー/押下） -->
        <Style x:Key="CloseFlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20222A"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3E4D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F4F4F4"/>
        </Style>

        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9ABB6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#3020222A"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Opacity="1.0"/>

        <Border Background="#B30E0F12"/>

        <!-- ★追加：UI本体だけ縮小スケール（小さい画面でも見切れない） -->
        <Viewbox Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">

            <!-- ★基準サイズ（ここを基準に画面が小さい時だけ縮小） -->
            <Grid Width="1920" Height="1080">

                <Border CornerRadius="22" Background="Transparent" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 上 -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="TimerCard"
                                    Grid.Row="0"
                                    Background="Transparent"
                                    Style="{StaticResource CardBorderStyle}"
                                    Padding="63"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="制限時間"
                                               Style="{StaticResource SubtleTextStyle}"
                                               HorizontalAlignment="Center"
                                               FontSize="48"/>
                                    <TextBlock x:Name="TimerText"
                                               Text="30"
                                               FontSize="55"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="WorkTitleText"
                                       Grid.Row="1"
                                       Style="{StaticResource TitleTextStyle}"
                                       Text=""
                                       FontSize="70"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 中：問題 -->
                        <Border Grid.Row="1"
                                Style="{StaticResource CardBorderStyle}"
                                Margin="125,70,125,70"
                                Background="#8017181D"
                                Padding="18">
                            <Grid>
                                <TextBox x:Name="QuestionText"
                                         Text="QUESTION"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         TextWrapping="Wrap"
                                         Foreground="White"
                                         FontSize="33"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </Grid>
                        </Border>

                        <!-- 下：Choice 3つ + 閉じる（ChoiceBtn3 の右側） -->
                        <Border Grid.Row="2" Margin="0,14,0,0" Background="Transparent">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>

                                <!-- Choice 1 -->
                                <Border Grid.Column="0"
                                        Background="#6617181D"
                                        CornerRadius="16"
                                        BorderThickness="0"
                                        Padding="10"
                                        Margin="0,0,10,0">
                                    <Border Style="{StaticResource SmallFieldBorderStyle}">
                                        <Button x:Name="ChoiceBtn1"
                                                Click="Choice_Click"
                                                Style="{StaticResource FlatButtonStyle}"
                                                Background="Transparent"
                                                Height="92"
                                                FontSize="25"
                                                Padding="18,14"/>
                                    </Border>
                                </Border>

                                <!-- Choice 2 -->
                                <Border Grid.Column="1"
                                        Background="#6617181D"
                                        CornerRadius="16"
                                        BorderThickness="0"
                                        Padding="10"
                                        Margin="0,0,10,0">
                                    <Border Style="{StaticResource SmallFieldBorderStyle}">
                                        <Button x:Name="ChoiceBtn2"
                                                Click="Choice_Click"
                                                Style="{StaticResource FlatButtonStyle}"
                                                Background="Transparent"
                                                Height="92"
                                                FontSize="25"
                                                Padding="18,14"/>
                                    </Border>
                                </Border>

                                <!-- Choice 3 -->
                                <Border Grid.Column="2"
                                        Background="#6617181D"
                                        CornerRadius="16"
                                        BorderThickness="0"
                                        Padding="10"
                                        Margin="0,0,10,0">
                                    <Border Style="{StaticResource SmallFieldBorderStyle}">
                                        <Button x:Name="ChoiceBtn3"
                                                Click="Choice_Click"
                                                Style="{StaticResource FlatButtonStyle}"
                                                Background="Transparent"
                                                Height="92"
                                                FontSize="25"
                                                Padding="18,14"/>
                                    </Border>
                                </Border>

                                <!-- ★閉じる（QuizDeleteWindowと同じ色） -->
                                <Border Grid.Column="3"
                                        Background="#6617181D"
                                        CornerRadius="16"
                                        BorderThickness="0"
                                        Padding="10"
                                        Margin="0,0,0,0">
                                    <Border Style="{StaticResource SmallFieldBorderStyle}">
                                        <Button x:Name="CloseBtn"
                                                Content="終了する"
                                                Click="CloseBtn_Click"
                                                Background="Transparent"
                                                Style="{StaticResource CloseFlatButtonStyle}"
                                                Height="92"
                                                FontSize="25"
                                                Padding="18,14"/>
                                    </Border>
                                </Border>

                            </Grid>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Viewbox>
    </Grid>
</Window>
