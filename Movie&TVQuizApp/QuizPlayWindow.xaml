<Window x:Class="Movie_AnimeQuizApp.Views.QuizPlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz" Height="600" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="#0E0F12"
        Foreground="#EDEDED">

    <Window.Resources>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#17181D"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#2A2C34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20222A"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3E4D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F4F4F4"/>
        </Style>

        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9ABB6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </Window.Resources>

    <Border CornerRadius="22" Background="#0E0F12" Padding="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 左：作品画像 -->
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                    Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0" Padding="0">
                <Grid ClipToBounds="True">
                    <Border CornerRadius="16">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding ElementName=PosterImage, Path=Source}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- 上：作品名 -->
            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,16,12">
                <TextBlock x:Name="WorkTitleText" Style="{StaticResource TitleTextStyle}"
                           Text="TITLE" HorizontalAlignment="Center" FontSize="30"/>
            </StackPanel>

            <!-- 右上：制限時間 -->
            <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="制限時間" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Center" FontSize="25"/>
                    <TextBlock x:Name="TimerText" Text="60"
                               FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 中：問題文 -->
            <Border Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}"
                    Margin="0,10,16,0" Padding="18" Grid.Row="1">
                <Grid>
                    <TextBlock x:Name="QuestionText"
                               Text="QUESTION"
                               TextWrapping="Wrap"
                               FontSize="20"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 下：選択肢（横3つ） -->
            <Border Grid.Column="1" Grid.Row="2" Margin="0,14,16,0" Background="Transparent">
                <UniformGrid Rows="1" Columns="3" HorizontalAlignment="Stretch">
                    <Button x:Name="ChoiceBtn1" Click="Choice_Click" Margin="0,0,10,0"
                            Style="{StaticResource FlatButtonStyle}" Height="64"/>
                    <Button x:Name="ChoiceBtn2" Click="Choice_Click" Margin="0,0,10,0"
                            Style="{StaticResource FlatButtonStyle}" Height="64"/>
                    <Button x:Name="ChoiceBtn3" Click="Choice_Click"
                            Style="{StaticResource FlatButtonStyle}" Height="64"/>
                </UniformGrid>
            </Border>

            <!-- ★右下の「次の問題へ」は削除（結果画面に移動） -->

        </Grid>
    </Border>
</Window>
