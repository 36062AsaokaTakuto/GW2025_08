<Window x:Class="Movie_AnimeQuizApp.SearchResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SearchResultWindow"
        WindowState="Maximized"
        Background="Black"
        Width="1000"
        PreviewMouseDown="Window_PreviewMouseDown">
<!--git-->
    <Window.Resources>

        <!-- =========================
             縦スクロールバー（全体）
             背景透明 / 白い線なし / 角丸グレーつまみ
           ========================= -->
        <Style x:Key="MainThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#7A7A7A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0"
                                Margin="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainVerticalScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MainThumbStyle}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter Grid.Column="0"/>

                            <ScrollBar Grid.Column="1"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Style="{StaticResource MainVerticalScrollBarStyle}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== MediaBrowserと同じ：ヘッダーヒット&メニューボタン ===== -->
        <Style x:Key="HeaderHitStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <Border x:Name="Accent"
                                    Background="#E50914"
                                    Height="5"
                                    VerticalAlignment="Bottom"
                                    Margin="6,0,6,4"
                                    Opacity="0"
                                    CornerRadius="2"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF0F0F0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E50914"/>
                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE6E6E6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E50914"/>
                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===== MediaBrowserと同じ：ヘッダー行 + メニュー行 + コンテンツ行 ===== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー行 -->
        <Border Grid.Row="0" Background="#AA000000" Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <!-- 戻るボタン（左上・重ね置き） -->
                <Button x:Name="BackButton"
                        Width="102"
                        Height="46"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,7,0,0"
                        BorderThickness="0"
                        Cursor="Hand"
                        Panel.ZIndex="2000"
                        Click="BackButton_Click"
                        Focusable="False"
                        ToolTip="戻る"
                        Grid.ColumnSpan="4">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bd"
                                        CornerRadius="23"
                                        Opacity="0.92"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Border CornerRadius="23"
                                        BorderThickness="1"
                                        BorderBrush="#33FFFFFF"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1F1F1F"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                </Trigger>

                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <TextBlock Text="❮"
                               FontSize="43"
                               FontWeight="ExtraBold"
                               Foreground="White"
                               Margin="0,0,2,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>

                <!-- 映画 -->
                <Border Grid.Column="0"
                        Style="{StaticResource HeaderHitStyle}"
                        MouseEnter="MovieHeader_MouseEnter"
                        MouseLeave="MovieHeader_MouseLeave">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="映画" Foreground="White" FontSize="24"/>
                        <TextBlock Text=" ▾" Foreground="#E50914" FontSize="22" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- テレビ番組 -->
                <Border Grid.Column="1"
                        Style="{StaticResource HeaderHitStyle}"
                        MouseEnter="TvHeader_MouseEnter"
                        MouseLeave="TvHeader_MouseLeave">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="テレビ番組" Foreground="White" FontSize="24"/>
                        <TextBlock Text=" ▾" Foreground="#E50914" FontSize="22" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- クイズ -->
                <Border Grid.Column="2"
                        Style="{StaticResource HeaderHitStyle}"
                        MouseEnter="QuizHeader_MouseEnter"
                        MouseLeave="QuizHeader_MouseLeave">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="クイズ" Foreground="White" FontSize="24"/>
                        <TextBlock Text=" ▾" Foreground="#E50914" FontSize="22" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Home（MediaBrowserと同じ） -->
                <Button Grid.Column="3"
                        Click="Home_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="44"
                        Height="44"
                        Content="🏠"
                        FontSize="22"
                        Foreground="White"/>
            </Grid>
        </Border>

        <!-- ホバーで出すメニュー行 -->
        <Grid Grid.Row="1" Background="Transparent" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <!-- 映画 -->
            <Border x:Name="MovieMenu"
                    Grid.Column="0"
                    Visibility="Collapsed"
                    Background="Transparent"
                    HorizontalAlignment="Center"
                    MouseEnter="Menu_MouseEnter"
                    MouseLeave="Menu_MouseLeave">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource MenuButtonStyle}" Content="人気" Click="MoviePopular_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="上映中" Click="MovieNowPlaying_Click"/>
                </StackPanel>
            </Border>

            <!-- TV -->
            <Border x:Name="TvMenu"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Background="Transparent"
                    HorizontalAlignment="Center"
                    MouseEnter="Menu_MouseEnter"
                    MouseLeave="Menu_MouseLeave">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource MenuButtonStyle}" Content="人気" Click="TvPopular_Click"/>
                    <Button Style="{StaticResource MenuButtonStyle}" Content="放送中" Click="TvOnAir_Click"/>
                </StackPanel>
            </Border>

            <!-- クイズ（MediaBrowserと同じ） -->
            <Border x:Name="QuizMenu"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Background="Transparent"
                    HorizontalAlignment="Center"
                    MouseEnter="Menu_MouseEnter"
                    MouseLeave="Menu_MouseLeave">
                <StackPanel Orientation="Vertical">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="QuizSearchHit"
                                Style="{StaticResource MenuButtonStyle}"
                                Content="クイズ回答"
                                Click="QuizSearchHit_Click"
                                MouseEnter="QuizSearchHit_MouseEnter"
                                MouseLeave="QuizSearchHit_MouseLeave"/>
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Content="クイズを作成"
                                Click="QuizCreate_Click"/>
                    </StackPanel>

                    <Border x:Name="QuizSearchPanel"
                            Visibility="Collapsed"
                            Margin="10,10,10,0"
                            Background="Transparent"
                            MouseEnter="QuizSearchPanel_MouseEnter"
                            MouseLeave="QuizSearchPanel_MouseLeave">
                        <Border Background="#66000000"
                                BorderBrush="#808080"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="10"
                                Width="340">
                            <Grid>
                                <TextBox x:Name="QuizSearchTextBox"
                                         FontSize="16"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="White"
                                         VerticalContentAlignment="Center"
                                         CaretBrush="White"
                                         Cursor="IBeam"
                                         GotFocus="QuizSearch_GotFocus"
                                         LostFocus="QuizSearch_LostFocus"
                                         PreviewKeyDown="QuizSearch_PreviewKeyDown"
                                         PreviewMouseLeftButtonDown="QuizSearch_PreviewMouseLeftButtonDown"
                                         TextChanged="QuizSearch_TextChanged"/>

                                <!-- プレースホルダー（TextBlock方式：入力扱いにならない） -->
                                <TextBlock Text="クイズしたい作品名を入力"
                                           Foreground="Gray"
                                           FontSize="16"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=QuizSearchTextBox, Path=Text}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </Grid>
                        </Border>
                    </Border>

                </StackPanel>
            </Border>

        </Grid>

        <!-- ===== コンテンツ（既存UI）===== -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource MainScrollViewerStyle}"
                      Background="Transparent"
                      BorderThickness="0">

            <Grid Margin="16">

                <!-- 背景：作品画像（TMDb backdrop） -->
                <Grid.Background>
                    <ImageBrush x:Name="BackdropBrush"
                                Stretch="UniformToFill"
                                Opacity="0.22" />
                </Grid.Background>

                <!-- メイン情報 -->
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 上：作品情報 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="600"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左: 作品画像と配信サイトアイコン -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Cursor="">

                            <Image x:Name="PosterImage" Width="443" Height="471" Margin="31,0" Cursor=""/>

                            <ScrollViewer HorizontalAlignment="Center"
                                          Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="180"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Width="440"
                                          ClipToBounds="True">

                                <Border Width="440"
                                        Background="Transparent"
                                        ClipToBounds="True">

                                    <UniformGrid x:Name="ProviderIcons"
                                                 Width="400"
                                                 Columns="4"
                                                 HorizontalAlignment="Center"
                                                 ClipToBounds="True"/>
                                </Border>
                            </ScrollViewer>

                        </StackPanel>

                        <!-- 右: 詳細情報 -->
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">

                            <TextBlock x:Name="TitleText"
                                       FontSize="58"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,16,0,16">
                                <Grid Width="140" Height="140">
                                    <Ellipse Stroke="Gray" StrokeThickness="12"/>
                                    <Path x:Name="UserScoreArc" Stroke="LimeGreen" StrokeThickness="12" Fill="Transparent">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="-90" CenterX="70" CenterY="70"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock x:Name="UserScoreText" Text="0%"
                                               Foreground="White"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Button x:Name="TrailerButton"
                                        Content="予告編を見る"
                                        FontSize="30"
                                        FontWeight="SemiBold"
                                        Margin="24,0,0,0"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="3"
                                        BorderBrush="#E50914"
                                        Padding="22,14"
                                        Click="TrailerButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="22"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock x:Name="ReleaseDateText" Foreground="White" FontSize="30" Margin="0,0,20,0"/>
                                <TextBlock x:Name="GenresText" Foreground="White" FontSize="30" Margin="0,0,20,0"/>
                                <TextBlock x:Name="RuntimeText" Foreground="White" FontSize="30"/>
                            </StackPanel>

                            <TextBlock Text="概要" Foreground="White" FontSize="33" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock x:Name="OverviewText" Foreground="White" FontSize="27" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- 下：出演俳優 -->
                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="出演者" Foreground="White" FontSize="37" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="ActorsScroll"
                                          Grid.Row="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ScrollChanged="ActorsScroll_ScrollChanged">
                                <StackPanel x:Name="ActorsPanel" Orientation="Horizontal"/>
                            </ScrollViewer>

                            <ScrollBar x:Name="ActorsHScroll"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       Height="18"
                                       Minimum="0"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       ValueChanged="ActorsHScroll_ValueChanged">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                                            <Track x:Name="PART_Track"
                                                   IsDirectionReversed="False"
                                                   Minimum="{TemplateBinding Minimum}"
                                                   Maximum="{TemplateBinding Maximum}"
                                                   Value="{TemplateBinding Value}"
                                                   ViewportSize="{TemplateBinding ViewportSize}">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border Background="#7A7A7A"
                                                                        CornerRadius="8"
                                                                        BorderThickness="0"
                                                                        Margin="0"
                                                                        Width="80"
                                                                        Height="14"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </StackPanel>

                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== 予告オーバーレイ（ヘッダーごと覆う）===== -->
        <Grid x:Name="TrailerOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#CC000000"
              Panel.ZIndex="9999"
              Focusable="True"
              KeyDown="TrailerOverlay_KeyDown">

            <Border Width="1400"
                    Height="788"
                    MaxWidth="1700"
                    MaxHeight="956"
                    Background="#111"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#1A1A1A">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="予告編"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>

                        <Button Grid.Column="1"
                                Width="44" Height="32"
                                Margin="0,10,12,10"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Cursor="Hand"
                                Click="CloseTrailer_Click"
                                Content="✕"/>
                    </Grid>

                    <wv2:WebView2 x:Name="TrailerWebView" Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
