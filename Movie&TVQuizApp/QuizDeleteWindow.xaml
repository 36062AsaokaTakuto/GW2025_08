<Window x:Class="Movie_AnimeQuizApp.Views.QuizDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Delete" Height="650" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#0E0F12"
        Foreground="#EDEDED"
        Loaded="Window_Loaded"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">


    <Window.Resources>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#17181D"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#2A2C34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20222A"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D38"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3E4D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9ABB6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#20222A"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="CaretBrush" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上：条件 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="作成者" VerticalAlignment="Center" FontSize="16"/>

                <!-- ★プレースホルダー付き（TextBox+TextBlock重ね） -->
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <TextBox x:Name="CreatedByTextBox"
                             Style="{StaticResource DarkTextBoxStyle}"
                             TextChanged="CreatedByTextBox_TextChanged"
                             GotFocus="CreatedBy_GotFocus"
                             LostFocus="CreatedBy_LostFocus"/>

                    <TextBlock x:Name="CreatedByWatermark"
                               Text="作成者を入力"
                               Foreground="Gray"
                               FontSize="14"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <Button Grid.Column="3"
                        Background="#E50914"
                        Content="一覧表示"
                        Style="{StaticResource FlatButtonStyle}"
                        Click="Reload_Click"/>

                <TextBlock x:Name="StatusText"
                           Grid.Column="4"
                           Style="{StaticResource SubtleTextStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Text=""/>
            </Grid>
        </Border>

        <!-- 中：一覧 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="この作成者のクイズ一覧（選択して削除）"
                           Style="{StaticResource SubtleTextStyle}"
                           FontSize="14"
                           HorizontalAlignment="Center"/>

                <ListBox x:Name="QuizList"
                         Grid.Row="1"
                         Margin="0,12,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         SelectionMode="Single"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <!-- ★横長レイアウト -->
                        <DataTemplate>
                            <Border Background="#121319" CornerRadius="12" Padding="12" Margin="0,0,0,10"
                                    BorderBrush="#2A2C34" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding WorkTitle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F4F4F4"/>
                                        <TextBlock Text="{Binding Question}"
                                                   FontSize="13"
                                                   Foreground="#D7D7D7"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Meta}"
                                               Style="{StaticResource SubtleTextStyle}"
                                               VerticalAlignment="Top"
                                               HorizontalAlignment="Right"
                                               Margin="14,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 下：操作 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="選択したクイズを削除"
                    Style="{StaticResource FlatButtonStyle}"
                    Background="#E50914"
                    Height="54"
                    Click="DeleteSelected_Click"/>

            <Button Grid.Column="3"
                    Content="閉じる"
                    Style="{StaticResource FlatButtonStyle}"
                    Height="54"
                    Click="Close_Click"/>
        </Grid>

    </Grid>
</Window>
